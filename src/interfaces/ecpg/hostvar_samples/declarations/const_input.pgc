#include <stdio.h>
#include <stdlib.h>

EXEC SQL INCLUDE sqlca;

static const char *current_step = "const_input";

static void
sql_error(void)
{
    fprintf(stderr, "SQL error during %s: %.*s (sqlcode=%ld)\n",
            current_step,
            (int) sqlca.sqlerrm.sqlerrml,
            sqlca.sqlerrm.sqlerrmc,
            (long) sqlca.sqlcode);
    EXEC SQL ROLLBACK;
    EXEC SQL DISCONNECT CURRENT;
    exit(EXIT_FAILURE);
}


int
main(void)
{
	const char *target_table;
	int			count_row;

	EXEC SQL WHENEVER SQLERROR DO sql_error();
	EXEC SQL CONNECT TO test USER oracle;

	target_table = "pg_class";

	EXEC SQL SELECT COUNT(*) INTO :count_row FROM pg_class WHERE relname = :target_table;
	printf("found %d rows for %s\n", count_row, target_table);

	EXEC SQL DISCONNECT CURRENT;
	return 0;
}
