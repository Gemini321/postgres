#include <stdio.h>
#include <stdlib.h>

EXEC SQL INCLUDE sqlca;

static const char *current_step = "matrix_2d";

static void
sql_error(void)
{
    fprintf(stderr, "SQL error during %s: %.*s (sqlcode=%ld)\n",
            current_step,
            (int) sqlca.sqlerrm.sqlerrml,
            sqlca.sqlerrm.sqlerrmc,
            (long) sqlca.sqlcode);
    EXEC SQL ROLLBACK;
    EXEC SQL DISCONNECT CURRENT;
    exit(EXIT_FAILURE);
}


int
main(void)
{
	int			matrix[2][2];

	EXEC SQL WHENEVER SQLERROR DO sql_error();
	EXEC SQL CONNECT TO test USER oracle;
    printf("Connected to database.\n");

    // @TODO: Unsupported feature: 2D array host variables
	EXEC SQL SELECT 1 INTO :matrix[0];
	printf("matrix[0][0]=%d\n", matrix[0][0]);

	EXEC SQL DISCONNECT CURRENT;
	return 0;
}
