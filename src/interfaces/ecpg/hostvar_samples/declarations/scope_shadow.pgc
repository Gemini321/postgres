#include <stdio.h>
#include <stdlib.h>

EXEC SQL INCLUDE sqlca;

static const char *current_step = "scope_shadow";

static void
sql_error(void)
{
    fprintf(stderr, "SQL error during %s: %.*s (sqlcode=%ld)\n",
            current_step,
            (int) sqlca.sqlerrm.sqlerrml,
            sqlca.sqlerrm.sqlerrmc,
            (long) sqlca.sqlcode);
    EXEC SQL ROLLBACK;
    EXEC SQL DISCONNECT CURRENT;
    exit(EXIT_FAILURE);
}


int
main(void)
{
	int			value = -1;

	EXEC SQL WHENEVER SQLERROR DO sql_error();
	EXEC SQL CONNECT TO test USER oracle;

	EXEC SQL SELECT 1 INTO :value;

	{
		int			value = -2;

		EXEC SQL SELECT 5 INTO :value;
		printf("inner value=%d\n", value);
	}

	printf("outer value=%d\n", value);

	EXEC SQL DISCONNECT CURRENT;
	return 0;
}
