#include <stdio.h>
#include <stdlib.h>

EXEC SQL INCLUDE sqlca;

static const char *current_step = "int_array";

static void
sql_error(void)
{
    fprintf(stderr, "SQL error during %s: %.*s (sqlcode=%ld)\n",
            current_step,
            (int) sqlca.sqlerrm.sqlerrml,
            sqlca.sqlerrm.sqlerrmc,
            (long) sqlca.sqlcode);
    EXEC SQL ROLLBACK;
    EXEC SQL DISCONNECT CURRENT;
    exit(EXIT_FAILURE);
}


int
main(void)
{
	int			values[4];

	EXEC SQL WHENEVER SQLERROR DO sql_error();
	EXEC SQL CONNECT TO test USER oracle;

	EXEC SQL SELECT 7 INTO :values[0];
	printf("values[0]=%d\n", values[0]);

	EXEC SQL DISCONNECT CURRENT;
	return 0;
}
