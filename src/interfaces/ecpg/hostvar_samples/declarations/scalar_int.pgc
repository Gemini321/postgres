#include <stdio.h>
#include <stdlib.h>

EXEC SQL INCLUDE sqlca;

static const char *current_step = "scalar_int";

static void
sql_error(void)
{
    fprintf(stderr, "SQL error during %s: %.*s (sqlcode=%ld)\n",
            current_step,
            (int) sqlca.sqlerrm.sqlerrml,
            sqlca.sqlerrm.sqlerrmc,
            (long) sqlca.sqlcode);
    EXEC SQL ROLLBACK;
    EXEC SQL DISCONNECT CURRENT;
    exit(EXIT_FAILURE);
}


int
main(void)
{
	int			balance;

	EXEC SQL WHENEVER SQLERROR DO sql_error();
	EXEC SQL CONNECT TO test USER oracle;

	EXEC SQL SELECT 1 INTO :balance;
	printf("balance=%d\n", balance);

	EXEC SQL DISCONNECT CURRENT;
	return 0;
}
