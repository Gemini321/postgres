#include <stdio.h>
#include <stdlib.h>

EXEC SQL INCLUDE sqlca;

static const char *current_step = "scope_typedef";

static void
sql_error(void)
{
    fprintf(stderr, "SQL error during %s: %.*s (sqlcode=%ld)\n",
            current_step,
            (int) sqlca.sqlerrm.sqlerrml,
            sqlca.sqlerrm.sqlerrmc,
            (long) sqlca.sqlcode);
    EXEC SQL ROLLBACK;
    EXEC SQL DISCONNECT CURRENT;
    exit(EXIT_FAILURE);
}


typedef struct
{
	int			amount;
} Foo;

int
main(void)
{
	Foo			f = {0};

	EXEC SQL WHENEVER SQLERROR DO sql_error();
	EXEC SQL CONNECT TO test USER oracle;

	EXEC SQL SELECT 3 INTO :f.amount;
	printf("outer Foo amount=%d\n", f.amount);

	{
		typedef struct
		{
			double		amount;
		} Foo;

		Foo			local = {0.0};

		EXEC SQL SELECT 7 INTO :local.amount;
		printf("inner Foo amount=%.0f\n", local.amount);
	}

	EXEC SQL DISCONNECT CURRENT;
	return 0;
}
